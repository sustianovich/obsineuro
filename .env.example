# Copia este archivo a .env y ajusta al menos OBSIDIAN_VAULT_PATH.
# powershell: Copy-Item .env.example .env
#
# Todos los valores de abajo son los predeterminados del código
# (ver app/config.py): puedes borrar cualquier línea y la aplicación
# seguirá funcionando con ese mismo valor.

# ---------------------------------------------------------------------
# Ollama local. La URL sólo admite loopback: es la garantía de que
# ningún dato del vault sale del equipo.
# ---------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Perfiles disponibles en la interfaz y su ventana de contexto real:
#   qwen3.5:0.8b     32K   ligero (recomendado para empezar)
#   qwen3.5:2b       32K   equilibrado
#   qwen3.5:4b       32K   calidad
#   llama3:latest     8K   contexto corto: los ajustes de agentes se
#                          recortan solos a 8192 con este modelo
#   gpt-oss:latest  128K   modelo de razonamiento, el más exigente
# Recuerda descargarlo antes: ollama pull <modelo>
OLLAMA_CHAT_MODEL=qwen3.5:0.8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=180

# Mantiene el modelo cargado entre consultas. Sin esto Ollama lo
# descarga a los 5 minutos y la siguiente pregunta paga el arranque.
OLLAMA_KEEP_ALIVE=30m

# ---------------------------------------------------------------------
# Rutas e indexación
# ---------------------------------------------------------------------
# Ruta absoluta al vault de Obsidian a indexar. En Windows usa barras `/`:
#   OBSIDIAN_VAULT_PATH=C:/Users/TU_USUARIO/Documents/MiVault
OBSIDIAN_VAULT_PATH=./vault_demo

# Opcional: fuerza una única base de datos compartida entre vaults. Si
# se omite (recomendado), cada vault usa su propia base en
# data/vaults/<slug>/rag_index.sqlite3 y el panel «Elegir vault» aísla
# documentos, proyectos y conversaciones entre vaults automáticamente.
# RAG_DATABASE_PATH=./data/rag_index.sqlite3

RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=250

# Lotes de embeddings enviados en paralelo durante la indexación.
# Subirlo acelera; pasarse satura Ollama y lo ralentiza. 3 es prudente.
RAG_EMBEDDING_WORKERS=3

# Prefijos de tarea del modelo de embedding: auto | nomic | e5 | bge | none
# `auto` los deduce del nombre del modelo. Cambiar este valor invalida
# el índice y fuerza una reconstrucción completa automática.
RAG_EMBEDDING_PREFIX_SCHEME=auto

# ---------------------------------------------------------------------
# Fragmentos padre-hijo (opcional)
# ---------------------------------------------------------------------
# Desactivado por defecto para conservar índices existentes. Activarlo,
# desactivarlo o cambiar cualquiera de estos tres tamaños dispara una
# reconstrucción atómica del índice. Ver «Fragmentos padre-hijo» en el
# README antes de activarlo en un vault real.
RAG_PARENT_CHILD_CHUNKING=false
RAG_PARENT_CHUNK_SIZE=6000
RAG_CHILD_CHUNK_SIZE=700
RAG_CHILD_CHUNK_OVERLAP=100

# ---------------------------------------------------------------------
# Recuperación
# ---------------------------------------------------------------------
RAG_TOP_K=6
RAG_MAX_OUTPUT_TOKENS=1800

# Umbral absoluto de coseno: es la única puerta real de abstención.
#
# Su escala DEPENDE DEL MODELO de embedding. No copies este valor a
# ciegas: mídelo contra tu vault con
#     python -m scripts.calibrate_threshold --detalle
# que propone un umbral y avisa si el margen de separación es frágil.
RAG_MIN_SIMILARITY=0.30

# Umbral relativo al mejor candidato: descarta lo que queda muy por
# debajo del primer resultado. Es la salvaguarda que de verdad actúa,
# y es comparable entre modelos de embedding distintos.
# 0 lo desactiva. Subirlo hace el sistema más estricto y más callado.
RAG_MIN_RELATIVE_SCORE=0.62

# Búsqueda híbrida (semántica + FTS5 con fusión RRF)
RAG_HYBRID_SEARCH=true
RAG_HYBRID_RRF_K=60
RAG_HYBRID_SEMANTIC_WEIGHT=1.0
RAG_HYBRID_LEXICAL_WEIGHT=0.8
RAG_HYBRID_CANDIDATE_MULTIPLIER=4

# Tercera rama opcional: propaga las mejores semillas semánticas por los
# wikienlaces materializados. No cambia embeddings ni fuerza reindexado.
# Desactivada por defecto: en más de un vault de referencia, activarla
# perjudicó las preguntas puramente factuales. Antes de activarla en un
# vault real, compárala con `python -m app.rag.evaluation --compare-strategies`.
RAG_GRAPH_SEARCH=false
RAG_GRAPH_WEIGHT=0.5
RAG_GRAPH_MAX_HOPS=2
RAG_GRAPH_DECAY=0.5
RAG_GRAPH_BACKLINK_WEIGHT=0.7
RAG_GRAPH_SEED_DOCUMENTS=4
RAG_GRAPH_MAX_CANDIDATES=20

# Enrutador determinista (sin LLM): decide por consulta si conviene
# activar el grafo y con qué peso. Desactivado por defecto hasta que un
# conjunto dorado propio de tu vault confirme que no perjudica lo factual.
RAG_QUERY_ROUTING=false
RAG_QUERY_ROUTER_RELATIONAL_PATTERNS=se relaciona,relacion entre,relacion con,como afecta,como impacta,impacto en,impacto de,depende de,dependen de,consecuencia de,vinculad,conecta con,conexion entre,flujo entre,cadena de,quien depende,que relacion hay
RAG_QUERY_ROUTER_STRUCTURAL_NOUNS=nodo,proceso,riesgo,rol,indicador,kpi,hallazgo,documento,nota,circuito,fase,etapa
RAG_QUERY_ROUTER_MIN_ENTITY_MENTIONS=2
RAG_QUERY_ROUTER_RELATIONAL_GRAPH_WEIGHT=0.5
RAG_QUERY_ROUTER_HYBRID_GRAPH_WEIGHT=0.25
RAG_QUERY_ROUTER_WEAK_EVIDENCE_MARGIN=0.05

# Abstención posterior a la fusión: infraestructura lista pero apagada
# por defecto porque los pesos no están calibrados con evaluación real.
# Para recoger telemetría sin rechazar recuperaciones no vacías, usa
# true + umbral 0.00 y calibra con scripts/calibrate_posterior_threshold.py.
RAG_POSTERIOR_ABSTENTION=false
RAG_POSTERIOR_ABSTENTION_THRESHOLD=0.35
RAG_VERIFIER_ABSTAIN_ON_INSUFFICIENT=false

# Filtro de vigencia temporal por defecto en la interfaz.
# Valores: (vacío) | vigente | futura | caducada | no_caducada
# `no_caducada` es lo razonable en un corpus normativo: deja fuera lo que
# ya dejó de regir sin ocultar lo que aún no ha entrado en vigor.
RAG_DEFAULT_VIGENCIA=

# Diversificación MMR: evita que varios fragmentos casi idénticos, o una
# sola nota larga, ocupen toda la ventana de contexto del redactor.
# lambda alto = prioriza relevancia; bajo = prioriza variedad.
RAG_MMR=true
RAG_MMR_LAMBDA=0.72
RAG_MAX_CHUNKS_PER_DOCUMENT=3

# ---------------------------------------------------------------------
# Reordenación (cross-encoder)
# ---------------------------------------------------------------------
# AVISO: Ollama no expone la cabeza de clasificación de los modelos
# cross-encoder y no tiene endpoint /api/rerank. Pedirle embeddings a
# bge-reranker-v2-m3 devuelve vectores, no relevancia. Por eso hay dos
# backends de verdad, y ninguno usa Ollama como reordenador nativo.
#
#   llm            : puntúa con el modelo de chat ya instalado.
#                    Sin dependencias nuevas. Más lento.
#   onnx / cross_encoder : sentence-transformers/ONNX en el propio proceso,
#                    que sí usa la cabeza de clasificación. Mejor calidad,
#                    pero arrastra dependencias adicionales. Sigue siendo
#                    local.
#
# Desactivado por defecto salvo en los perfiles Equilibrado y Calidad:
# cuesta una pasada extra de inferencia.
RAG_RERANK=false
RAG_RERANK_BACKEND=onnx
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_ONNX_MODEL_DIR=./models/bge-reranker-v2-m3-onnx
RAG_RERANK_ONNX_MAX_TOKENS=512
RAG_RERANK_CANDIDATES=12
RAG_RERANK_WEIGHT=0.7
RAG_RERANK_MAX_PASSAGE_CHARS=900
RAG_RERANK_BATCH_SIZE=6

# ---------------------------------------------------------------------
# Respuesta
# ---------------------------------------------------------------------
# Con false, la interfaz usa automáticamente la vía clásica sin streaming.
RAG_STREAMING=true

# Estos valores son un techo deseado, no una garantía: al responder se
# recortan a la ventana real del modelo activo. Con llama3:latest (8K)
# un redactor de 16384 se convierte en 8192 automáticamente.
RAG_VERIFIER_CONTEXT_TOKENS=8192
RAG_WRITER_CONTEXT_TOKENS=16384
RAG_VERIFIER_MAX_OUTPUT_TOKENS=600

# ---------------------------------------------------------------------
# Memoria conversacional y de proyecto
# ---------------------------------------------------------------------
RAG_MEMORY_SUMMARY_INTERVAL=10
RAG_MEMORY_RECENT_TURNS=4
RAG_MEMORY_MAX_CONTEXT_CHARS=12000
RAG_MEMORY_SUMMARY_MAX_INPUT_CHARS=40000
RAG_MEMORY_SUMMARY_MAX_TOKENS=700

RAG_PROJECT_MEMORY_MAX_CONTEXT_CHARS=6000
RAG_PROJECT_MEMORY_SUMMARY_INTERVAL=10
RAG_PROJECT_MEMORY_SUMMARY_MAX_INPUT_CHARS=40000
RAG_PROJECT_MEMORY_SUMMARY_MAX_TOKENS=700
